{
  "name": "postilla",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted comment system for static blogs.",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @postilla/server dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @postilla/server db:generate",
    "db:migrate": "pnpm --filter @postilla/server db:migrate",
    "db:drift": "pnpm --filter @postilla/server db:drift",
    "db:studio": "pnpm --filter @postilla/server db:studio",
    "db:backfill-html": "pnpm --filter @postilla/server db:backfill-html",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}

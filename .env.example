# Copy to .env for local development. `docker compose up -d` provides the
# Postgres and Mailpit these defaults point at.

NODE_ENV=development
PORT=8360
HOST=0.0.0.0
LOG_LEVEL=debug

DATABASE_URL=postgres://postilla:postilla@localhost:5432/postilla
DATABASE_POOL_MAX=10

# Public origin of this server; used to build permalinks in notifications.
SERVER_URL=http://localhost:8360
# Comma-separated origins allowed to embed the widget. Empty means same-origin only.
ALLOWED_ORIGINS=http://localhost:5173

SITE_NAME="Postilla Dev"
SITE_URL=http://localhost:5173

DEFAULT_LOCALE=en

# At least 32 characters. Generate with: openssl rand -base64 48
SECRET_KEY=dev-only-secret-key-change-me-in-production-please

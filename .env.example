# Copy to .env for local development. `docker compose up -d` provides the
# Postgres and Mailpit these defaults point at.

NODE_ENV=development
PORT=8360
HOST=0.0.0.0
LOG_LEVEL=debug

# The local compose database uses trust auth, so no password is needed.
# A deployed database must use a real password and TLS.
DATABASE_URL=postgres://postilla@localhost:5432/postilla
DATABASE_POOL_MAX=10

# Public origin of this server; used to build permalinks in notifications.
SERVER_URL=http://localhost:8360
# Comma-separated origins allowed to embed the widget. Empty means same-origin only.
ALLOWED_ORIGINS=http://localhost:5173

SITE_NAME="Postilla Dev"
SITE_URL=http://localhost:5173

DEFAULT_LOCALE=en

# At least 32 characters. Generate with: openssl rand -base64 48
SECRET_KEY=dev-only-secret-key-change-me-in-production-please

# ── Moderation ────────────────────────────────────────────────────────────────
# Hold every comment for review.
COMMENT_AUDIT=false
# Hold only a commenter's first comment; publish them automatically after that.
COMMENT_AUDIT_FIRST_ONLY=false
# Comma-separated, case-insensitive substrings that reject a comment outright.
FORBIDDEN_WORDS=

# ── Submission limits ─────────────────────────────────────────────────────────
COMMENT_MIN_INTERVAL_SECONDS=15
COMMENT_MAX_PER_WINDOW=10
COMMENT_WINDOW_SECONDS=3600
COMMENT_MAX_LENGTH=5000
COMMENT_MAX_NAME_LENGTH=60

# ── Third parties. Leave unset to disable the integration entirely. ───────────
# Akismet fails open: if it is unreachable, comments are still accepted.
AKISMET_KEY=
# Turnstile fails closed: if it is unreachable, submissions are rejected.
TURNSTILE_SECRET=

# ── Notifications ─────────────────────────────────────────────────────────────
# A channel with no credentials is not built at all, so leaving these unset
# disables it rather than half-enabling it. Configured channels are listed
# by GET /ready.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=
WEBHOOK_URL=

# Points at Mailpit from docker-compose, so local sends never leave the machine.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=postilla@example.com
NOTIFY_EMAIL_TO=you@example.com

# Reactions landing inside this window collapse into a single notification,
# so a visitor clicking forty times does not send forty messages.
REACTION_COALESCE_WINDOW_SECONDS=900
OUTBOX_POLL_INTERVAL_MS=5000
# Set false to run the API without an in-process notification worker.
OUTBOX_WORKER_ENABLED=true
